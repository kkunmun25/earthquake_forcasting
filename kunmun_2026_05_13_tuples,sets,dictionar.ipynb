   "source": [
    "from collections import Counter\n",
    "\n",
    "text =\"python is easy and python is powerful\"\n",
    "word = text.lower().split()\n",
    "word_count = Counter(word)\n",
    "print(word_count)\n",
    "\n",
    "for word, count in word_count.items():\n",
    "    print(f\"{word}: {count}\")\n",
    "\n"
   ]
  }
